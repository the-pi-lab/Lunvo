    "@react-three/fiber": "^9.7.0",
    "@tiptap/extension-placeholder": "^3.30.5",
    "@tiptap/pm": "^3.30.5",
    "@tiptap/react": "^3.30.5",
    "@tiptap/starter-kit": "^3.30.5",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^11.11.9",
    "groq-sdk": "^0.7.0",
    "gsap": "^3.15.0",
    "jspdf": "^4.2.1",
    "lenis": "^1.3.26",
    "lucide-react": "^0.453.0",
    "next": "15.5.9",
    "next-intl": "^4.14.1",
    "pptxgenjs": "^4.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.0",
    "rss-parser": "^3.13.0",
    "tailwind-merge": "^2.5.4",
    "three": "^0.185.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "latest",
    "@playwright/test": "^1.62.1",
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/addon-mcp": "latest",
    "@storybook/addon-vitest": "^10.5.10",
    "@storybook/nextjs-vite": "^10.5.10",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.16.11",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/browser-playwright": "4.1.11",
    "@vitest/coverage-v8": "4.1.11",
    "autoprefixer": "^10.4.20",
    "class-variance-authority": "^0.7.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.5.9",
    "eslint-plugin-storybook": "^10.5.10",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.3.0",
    "playwright": "latest",
    "postcss": "^8.4.47",
    "prettier": "^3.9.6",
    "storybook": "^10.5.10",
    "tailwindcss": "^3.4.14",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.23.12",
    "typescript": "^5.6.3",
    "vite": "latest",
    "vitest": "^4.1.11"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  }
