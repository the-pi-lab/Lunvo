# Next.js Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# AI Configuration (Bring Your Own Key — Any or all of these)
GROQ_API_KEY="gsk_..."
GEMINI_API_KEY="AIzaSy..."
OPENAI_API_KEY="sk-..."
ANTHROPIC_API_KEY="sk-ant-..."

# Global AI Default Override (Optional)
AI_PROVIDER="groq" # "groq" | "gemini" | "openai" | "anthropic" | "ollama"
AI_MODEL="llama-3.3-70b-versatile"

# 24/7 Telegram Companion Bot (Optional)
TELEGRAM_BOT_TOKEN="123456789:ABCdefGhIJKlmNoPQRstuVWxYz..."
TELEGRAM_CHAT_ID="987654321"
# REQUIRED if you expose /api/telegram to the internet (self-host public):
# TELEGRAM_WEBHOOK_SECRET="long-random-string"

# News API (Optional for extra trending news sources)
CURRENTS_API_KEY=""

# Local Rate Limiter & Security (Optional)
ADMIN_EMAIL="admin@example.com"
# REQUIRED if you expose /api/cron/rss-refresh publicly (self-host public):
# CRON_SECRET="long-random-string"
# Optional distributed limiter for public deploys (default Memory fail-closed in prod):
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""
# DO NOT COMMIT real keys. Rotate leaked keys immediately.

