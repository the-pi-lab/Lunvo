# Next.js Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Rate Limiter (Phase 18 — Local-First, no Supabase required)
# Default: in-memory (single instance, local dev). For serverless (Vercel) set Upstash Redis:
# UPSTASH_REDIS_REST_URL="https://your-upstash-url"
# UPSTASH_REDIS_REST_TOKEN="your-upstash-token"
# OR custom connector endpoint (your own backend implements POST {key,limit,windowMs} -> RateLimitResult):
# LUNVO_RATE_LIMIT_CONNECTOR_URL="https://your-connector.example.com/rate-limit"

# Supabase Configuration — OPTIONAL now (local-first). Only if you want hosted auth/DB:
# NEXT_PUBLIC_SUPABASE_URL="your-supabase-project-url"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
# SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Admin Access
# Set the email address that should have access to the /admin route
ADMIN_EMAIL="your_email@example.com"

# AI Configuration (Bring Your Own Key)
# Configure these if you want global default keys, or set them in the app dashboard
GEMINI_API_KEY="your-gemini-api-key"
GROQ_API_KEY="your-groq-api-key"

# Optional: Currents News API for additional latest/search news coverage
CURRENTS_API_KEY="your-currents-api-key"
